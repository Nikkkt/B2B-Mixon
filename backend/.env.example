# Database Configuration
DB_CONNECTION=Host=localhost;Database=mixon_b2b;Username=postgres;Password=your_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_ISSUER=MixonB2B
JWT_AUDIENCE=MixonB2BUsers

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration for Order Notifications
# Brevo (recommended): set BREVO_API_KEY and optionally BREVO_FROM_EMAIL / BREVO_FROM_NAME
BREVO_API_KEY=
BREVO_FROM_EMAIL=your-email@gmail.com
BREVO_FROM_NAME=Mixon B2B
# SendGrid (alternative): set SENDGRID_API_KEY and optionally SENDGRID_FROM_EMAIL / SENDGRID_FROM_NAME
SENDGRID_API_KEY=
# SMTP fallback: used when no Brevo/SendGrid API key is configured
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=your-email@gmail.com
Email__SmtpPassword=your-app-password-here
Email__FromEmail=noreply@mixon.com
Email__FromName=Mixon B2B System

# New user registration notification (comma/semicolon separated recipients)
# Example: REGISTRATION_NOTIFICATION_EMAIL=d.slobyak@mixon.ua
REGISTRATION_NOTIFICATION_EMAIL=

# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Use the generated 16-character password in Email__SmtpPassword

# Other SMTP Providers:
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587
